# Copy this file to `.env` and fill in your own credentials.
# Never commit `.env`.

# ---------------------------------------------------------------------------
# LLM providers
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=your_deepseek_api_key
OPENAI_API_KEY=your_openai_api_key
# Optional OpenAI-compatible relay endpoint (leave empty to use the default).
OPENAI_PROXY_URL=
DASHSCOPE_API_KEY=your_dashscope_api_key
ZAI_API_KEY=your_zai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_PROXY_URL=

# ---------------------------------------------------------------------------
# CodeQL
# ---------------------------------------------------------------------------
# Absolute path to the CodeQL executable.
CODEQL_BIN=/path/to/codeql

# ---------------------------------------------------------------------------
# Budget and cache controls (optional; defaults are defined in code)
# ---------------------------------------------------------------------------
# MODEL_SINGLE_MSG_RATIO=0.5
# MODEL_TOKEN_BUDGET_RATIO=0.85
# MODEL_TOKEN_LIMIT=1048576
# SYMBOL_INDEX_CACHE_SIZE=
# FUSION_GROUP_MAPPING=
